# Environment for deploy/forgejo/compose.yml. Paste into the Dokploy
# project's Environment tab and fill in the blanks there; never commit the
# real values. See docs/forgejo.md.

# Public host name; ROOT_URL becomes https://$FORGEJO_DOMAIN/.
FORGEJO_DOMAIN=git.sdoc.gov.np

# Postgres password for the forgejo role. Generate once: openssl rand -hex 32
FORGEJO_DB_PASSWORD=

# Forgejo's global secret. Generate once and never change it: data encrypted
# with it (2FA secrets, for example) becomes unreadable without it.
#   openssl rand -hex 32
FORGEJO_SECRET_KEY=

# The network Traefik reaches Forgejo through, as CIDR(s), comma separated:
#   sudo docker network inspect dokploy-network --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}' | xargs | tr ' ' ','
FORGEJO_TRUSTED_PROXIES=

# Hosts webhooks may be sent to (phase 1): the tracker only.
FORGEJO_WEBHOOK_ALLOWED_HOSTS=tasks.sdoc.gov.np

# SDOC's SMTP account (implicit TLS on 465), the same one the tracker uses.
FORGEJO_SMTP_ADDR=smtp.nepal.gov.np
FORGEJO_SMTP_PORT=465
FORGEJO_SMTP_USER=no-reply@sdoc.gov.np
FORGEJO_SMTP_PASSWORD=
FORGEJO_MAIL_FROM="SDOC Git <no-reply@sdoc.gov.np>"

# Production leaves these out. Only a restore drill's scratch copy sets them,
# so it can't take port 2222 or email real people (docs/forgejo.md, Backups).
# FORGEJO_SSH_PUBLISH_PORT=2222
# FORGEJO_MAILER_ENABLED=true

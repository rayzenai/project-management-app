.git
node_modules
vendor
.env
.env.*
# Stale package manifests from the dev machine list dev-only providers
# (laravel/pail) that a --no-dev image does not ship — artisan then dies with
# "Class Laravel\Pail\PailServiceProvider not found" during the wayfinder step.
# Git-ignored, so a Dokploy clone never has these; this keeps local builds identical.
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
tests

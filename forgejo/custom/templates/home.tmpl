{{/* SDOC Git's home page, in place of Forgejo's (templates/home.tmpl in 15.0).
     Only visitors who are signed out see it; the button goes straight to the
     tracker's sign-in, the OIDC source "sdoc-tasks" (docs/forgejo.md, step 5). */}}
{{template "base/head" .}}
<div role="main" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home"}}{{end}}" class="page-content home sdoc-home">
	<a class="sdoc-identity" href="https://sdoc.gov.np">
		<img src="{{AssetUrlPrefix}}/img/logo.svg" width="76" height="76" alt="Emblem of Nepal">
		<span class="sdoc-identity-text">
			<span class="sdoc-ministry" lang="ne">प्रधानमन्त्री तथा मन्त्रिपरिषद्को कार्यालय</span>
			<strong lang="ne">सफ्टवेयर विकास तथा सञ्चालन केन्द्र</strong>
			<span class="sdoc-english" lang="en">Software Development and Operation Centre</span>
		</span>
	</a>

	<section class="sdoc-hero">
		<h1>{{AppName}}</h1>
		<p class="sdoc-lead">The Software Development and Operation Centre's own code forge, where the source code of its projects is written, reviewed and kept.</p>
		<div class="sdoc-actions">
			<a class="ui primary button" href="{{AppSubUrl}}/user/oauth2/sdoc-tasks">
				<img src="{{AssetUrlPrefix}}/img/sdoc-tasks.svg" alt="" aria-hidden="true">
				Sign in with SDOC Tasks
			</a>
			<a class="ui basic button" href="https://tasks.sdoc.gov.np">Open SDOC Tasks</a>
		</div>
		<p class="sdoc-note">For the centre's staff and project teams, with their SDOC Tasks account.</p>
	</section>

	<div class="sdoc-points">
		<section class="sdoc-point">
			{{svg "octicon-server" 20}}
			<h2>On the centre's own servers</h2>
			<p>SDOC keeps the source code of its projects on its own servers, under its own control, rather than with an outside provider.</p>
		</section>
		<section class="sdoc-point">
			{{svg "octicon-lock" 20}}
			<h2>Each office's own</h2>
			<p>An office's repositories are open only to its people and the teams on its projects.</p>
		</section>
		<section class="sdoc-point">
			{{svg "octicon-shield-check" 20}}
			<h2>Two-factor sign-in</h2>
			<p>Staff sign in through SDOC Tasks and then enter a code from an authenticator app.</p>
		</section>
	</div>
</div>
{{template "base/footer" .}}

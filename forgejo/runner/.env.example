# Environment for the git-runners compose (forgejo/runner/compose.yml). Paste
# into its Environment tab in Dokploy and fill in the blanks there; never
# commit the real values. See docs/forgejo.md, section 14.
#
# One secret per runner: 40 hexadecimal characters, each registered on the
# forge with
#   forgejo forgejo-cli actions register --scope sdoc --name sdoc-runner-N --secret-stdin=-
# Generate each once:
#   openssl rand -hex 20
RUNNER_SECRET_1=
RUNNER_SECRET_2=
RUNNER_SECRET_3=
RUNNER_SECRET_4=

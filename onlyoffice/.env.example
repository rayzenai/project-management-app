# Environment for the docs-onlyoffice application (onlyoffice/Dockerfile).
# Paste into its Environment tab in Dokploy and fill in the blanks there;
# never commit the real values. See docs/onlyoffice.md.

# Signs every editor session and every call between the editor and the
# tracker. The tracker's ONLYOFFICE_JWT_SECRET is the same value.
#   openssl rand -hex 32
JWT_SECRET=

# Signs the editor's links to its own cache files. Fixed, so a link handed out
# before a restart still works after it.
#   openssl rand -hex 32
SECURE_LINK_SECRET=

# The only origin the editor fetches documents from and sends saves to.
DOCS_TRACKER_URL=https://tasks.sdoc.gov.np/
